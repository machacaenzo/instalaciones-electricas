@model WebMVC_Instalaciones.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel glow">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="title-cyber">EDITAR USUARIO</h2>
                    <p class="subtitle-cyber">MODIFICACIÓN DE DATOS</p>
                </div>
                <a asp-action="Usuarios" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> VOLVER
                </a>
            </div>

            <form asp-action="EditarUsuario" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Activo" />
                <!-- Mandamos el IdRol oculto si no queremos que lo cambien, o dejamos el select -->

                <!-- SELECT DE ROL -->
                <div class="mb-3">
                    <span class="input-label">ROL</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-shield-lock text-warning"></i>
                        <select asp-for="IdRol" class="bg-transparent border-0 text-white w-100" style="outline:none;">
                            <option value="3" class="text-dark">INSTALADOR</option>
                            <option value="1" class="text-dark">ADMINISTRADOR</option>
                            <option value="2" class="text-dark">CLIENTE</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="input-label">NOMBRE COMPLETO</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-person-vcard"></i>
                        <input asp-for="NombreCompleto" />
                    </div>
                </div>

                <div class="mb-3">
                    <span class="input-label">CORREO</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Correo" />
                    </div>
                </div>

                <div class="mb-3">
                    <span class="input-label">CELULAR</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-telephone"></i>
                        <input asp-for="Celular" />
                    </div>
                </div>

                <!-- CLAVE OPCIONAL -->
                <div class="mb-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="input-label text-warning">CAMBIAR CONTRASEÑA (OPCIONAL)</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-key"></i>
                        <input asp-for="Clave" type="text" placeholder="Dejar vacío para mantener la actual" />
                    </div>
                    <small class="text-white-50">Solo escribí acá si querés resetear la clave del usuario.</small>
                </div>

                <button type="submit" class="btn-neon">
                    GUARDAR CAMBIOS
                </button>
            </form>
        </div>
    </div>
</div>