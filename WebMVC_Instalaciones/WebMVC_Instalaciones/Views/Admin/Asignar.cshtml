@model WebMVC_Instalaciones.Models.Solicitud

@{
    ViewData["Title"] = "Asignar Técnico";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // Recuperamos la lista de técnicos que mandamos desde el controller
    var listaTecnicos = ViewBag.Tecnicos as List<WebMVC_Instalaciones.Models.Usuario>;
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="glass-panel glow">
            <div class="mb-4 text-center">
                <h2 class="title-cyber">ASIGNACIÓN DE PERSONAL</h2>
                <p class="subtitle-cyber">ORDEN #@Model.Id</p>
            </div>

            <!-- DETALLES DE LA SOLICITUD (Solo lectura) -->
            <div class="mb-4 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                <div class="mb-2">
                    <span class="text-warning small fw-bold">PROBLEMA REPORTADO:</span>
                    <p class="text-white mb-0">@Model.Descripcion</p>
                </div>
                <div class="row mt-3">
                    <div class="col-6">
                        <span class="text-white-50 small">DIRECCIÓN:</span>
                        <div class="text-white fw-bold">@Model.Direccion</div>
                    </div>
                    <div class="col-6">
                        <span class="text-white-50 small">FECHA REQUERIDA:</span>
                        <div class="text-white fw-bold">@Model.FechaDeseada.ToShortDateString()</div>
                    </div>
                </div>
            </div>

            <!-- FORMULARIO DE SELECCIÓN -->
            <form asp-action="ConfirmarAsignacion" method="post">
                <input type="hidden" name="idSolicitud" value="@Model.Id" />

                <div class="mb-4">
                    <label class="input-label">SELECCIONAR TÉCNICO DISPONIBLE</label>
                    <div class="input-group-cyber">
                        <i class="bi bi-tools text-warning"></i>

                        <!-- SELECT CON ESTILO CYBER -->
                        <select name="idTecnico" class="bg-transparent border-0 text-white w-100" style="outline:none; cursor:pointer;">
                            <option value="" class="text-dark">-- Elegir Instalador --</option>
                            @if (listaTecnicos != null)
                            {
                                foreach (var tec in listaTecnicos)
                                {
                                    <option value="@tec.Id" class="text-dark">
                                        @tec.NombreCompleto
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Solicitudes" class="btn btn-outline-light w-50 rounded-pill fw-bold">CANCELAR</a>
                    <button type="submit" class="btn-neon w-50" style="margin-top:0;">CONFIRMAR</button>
                </div>
            </form>

        </div>
    </div>
</div>