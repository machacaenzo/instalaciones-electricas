@model WebMVC_Instalaciones.Models.UsuarioLogin
@{
    ViewData["Title"] = "Acceso";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso al Sistema</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Iconos -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Fuente -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- CSS Propio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="container d-flex justify-content-center align-items-center vh-100">

        <!-- Tarjeta -->
        <div class="glass-panel glow" style="width: 380px;">

            <div class="text-center">
                <h2 class="title-cyber">SYSTEM ACCESS</h2>
                <p class="subtitle-cyber">AUTENTICACIÓN REQUERIDA</p>
            </div>

            <!-- Alerta de Error (Credenciales Incorrectas) -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 px-2 mb-4 text-center small border-0"
                     style="background: rgba(255, 68, 68, 0.1); color: #ff6b6b; border: 1px solid #ff4444;">
                    <i class="bi bi-x-circle me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">

                <!-- USUARIO -->
                <div class="mb-1">
                    <span class="input-label">USUARIO / CORREO</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-person"></i>
                        <input asp-for="Correo" placeholder="user@system.com" autocomplete="off" />
                    </div>
                </div>
                <!-- Mensaje de validación -->
                <div class="mb-3">
                    <span asp-validation-for="Correo" class="text-danger fw-bold small" style="font-size:0.75rem; text-shadow: 0 1px 2px black;"></span>
                </div>

                <!-- CONTRASEÑA -->
                <div class="mb-1">
                    <span class="input-label">CONTRASEÑA</span>
                    <div class="input-group-cyber">
                        <i class="bi bi-key"></i>
                        <input asp-for="Clave" type="password" placeholder="••••••••" />
                    </div>
                </div>
                <!-- Mensaje de validación -->
                <div class="mb-4">
                    <span asp-validation-for="Clave" class="text-danger fw-bold small" style="font-size:0.75rem; text-shadow: 0 1px 2px black;"></span>
                </div>

                <!-- BOTÓN -->
                <button type="submit" class="btn-neon">
                    INICIAR SISTEMA
                </button>

            </form>

            <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-25">
                <a asp-action="Register" class="link-cyber">
                    <i class="bi bi-plus-circle me-1"></i> Crear nueva cuenta
                </a>
            </div>
        </div>

    </div>

    <!-- 1. LIBRERÍAS BÁSICAS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 2. SCRIPTS DE VALIDACIÓN + TRADUCCIÓN -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.5/localization/messages_es.min.js"></script>

    <!-- 3. SWEETALERT (Solo para éxito) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alerts.js"></script>

    <script>
        // USAMOS Html.Raw PARA QUE NO SALGAN SÍMBOLOS RAROS EN LOS ACENTOS
        var mensajeRegistro = '@Html.Raw(TempData["Mensaje"])';

        if (mensajeRegistro) {
            MostrarExito(mensajeRegistro);
        }
    </script>
</body>
</html>