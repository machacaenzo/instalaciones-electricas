@model IEnumerable<WebMVC_Instalaciones.Models.Solicitud>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <!-- Bootstrap CDN para que se vea ordenado en el PDF -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid black;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2>⚡ ElecService S.A.</h2>
        <h4>Reporte General de Operaciones</h4>
        <p>Generado el: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Dirección</th>
                <th>Cliente</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaDeseada.ToShortDateString()</td>
                    <td>@item.Direccion</td>
                    <td>@(item.Cliente?.NombreCompleto ?? "-")</td>
                    <td>
                        @if (item.IdEstadoSolicitud == 1)
                        {
                            <span>PENDIENTE</span>
                        }
                        else if (item.IdEstadoSolicitud == 2)
                        {
                            <span>EN PROCESO</span>
                        }
                        else if (item.IdEstadoSolicitud == 3)
                        {
                            <span class="fw-bold text-success">FINALIZADA</span>
                        }
                        else
                        {
                            <span class="text-danger">CANCELADA</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-4">
        <strong>Total de Registros: @Model.Count()</strong>
    </div>

</body>
</html>