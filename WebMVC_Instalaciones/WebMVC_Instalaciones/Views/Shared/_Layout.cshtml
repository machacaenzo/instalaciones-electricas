<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElecService</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ICONOS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- FUENTE -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <!-- CSS GLOBAL -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <!-- NAVBAR CYBER -->
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary border-opacity-25"
             style="background: rgba(10,10,10,0.95); backdrop-filter: blur(10px);">

            <div class="container">
                <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> ElecService
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">

                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            // --- LOGUEADO ---

                            if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Solicitudes" asp-action="Index">Mis Solicitudes</a></li>
                            }

                            if (User.IsInRole("Instalador"))
                            {
                                <li class="nav-item"><a class="nav-link text-info" asp-controller="Solicitudes" asp-action="MisTrabajos">Hoja de Ruta</a></li>
                            }

                            if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link text-warning" asp-controller="Admin" asp-action="Dashboard">ADMIN PANEL</a></li>
                            }

                            // USUARIO (CON FOTO)
                            <li class="nav-item ms-3 ps-3 border-start border-secondary border-opacity-25 d-flex align-items-center">

                                <!-- FOTO DE PERFIL (Desde API) -->
                                <img src="https://localhost:7088/api/Usuarios/@User.FindFirst("IdUsuario")?.Value/foto"
                                     onerror="this.src='https://ui-avatars.com/api/?name=@User.Identity.Name&background=random&color=fff&size=64'"
                                     class="rounded-circle me-2 shadow-sm"
                                     style="width: 35px; height: 35px; object-fit: cover; border: 1px solid var(--neon-main);"
                                     alt="Foto" />

                                <a class="text-white small text-uppercase fw-bold text-decoration-none"
                                   asp-controller="Account" asp-action="Perfil"
                                   title="Editar Mi Perfil">
                                    @User.Identity.Name
                                </a>
                            </li>

                            // Salir
                            <li class="nav-item ms-2">
                                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout" title="Cerrar Sesión">
                                    <i class="bi bi-power" style="font-size: 1.2rem;"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            // --- PÚBLICO ---
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Ingresar</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-sm btn-neon fw-bold text-dark" asp-controller="Account" asp-action="Register">
                                    REGISTRATE
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="mt-auto py-4 border-top border-secondary border-opacity-25"
            style="background: rgba(5,5,5,0.95); backdrop-filter: blur(10px);">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4 text-center text-md-start">
                    <h5 class="text-white fw-bold mb-2">
                        <i class="bi bi-lightning-charge-fill text-warning"></i> ElecService
                    </h5>
                    <p class="small text-white-50 mb-0">Gestión inteligente de servicios eléctricos urbanos.</p>
                </div>
                <div class="col-md-4 text-center">
                    <h6 class="text-uppercase text-white fw-bold mb-3 small" style="letter-spacing: 2px;">Navegación</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none small hover-white">Inicio</a></li>
                        <li><a asp-controller="Account" asp-action="Login" class="text-white-50 text-decoration-none small hover-white">Acceso</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <h6 class="text-uppercase text-white fw-bold mb-3 small" style="letter-spacing: 2px;">Soporte</h6>
                    <p class="small text-white-50 mb-0">soporte@elecservice.com</p>
                </div>
            </div>
            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-10">
                <small class="text-white-50">&copy; 2025 ElecService - Todos los derechos reservados.</small>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alerts.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            var mensajeExito = '@Html.Raw(TempData["Mensaje"] ?? "")';
            var mensajeError = '@Html.Raw(TempData["Error"] ?? "")';
            var mensajeBienvenida = '@Html.Raw(TempData["Bienvenida"] ?? "")';

            if (mensajeExito && mensajeExito.trim().length > 0) MostrarExito(mensajeExito);
            if (mensajeError && mensajeError.trim().length > 0) MostrarError(mensajeError);

            if (mensajeBienvenida && mensajeBienvenida.trim().length > 0) {
                Swal.fire({
                    title: '¡HOLA!',
                    text: mensajeBienvenida,
                    icon: 'success',
                    customClass: {
                        popup: 'cyber-alert-popup cyber-welcome-popup',
                        title: 'cyber-welcome-title',
                        confirmButton: 'swal2-confirm cyber-welcome-btn'
                    },
                    background: '#050505',
                    color: '#fff',
                    confirmButtonColor: '#D4FF00',
                    confirmButtonText: 'CONTINUAR',
                    backdrop: `rgba(0,0,0,0.9)`,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>