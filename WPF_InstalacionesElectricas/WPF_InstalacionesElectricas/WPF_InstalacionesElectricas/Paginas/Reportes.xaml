<Page x:Class="WPF_InstalacionesElectricas.Paginas.Reportes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Reportes" Background="Transparent">

    <!-- Margen general de la página -->
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fila 0: TÍTULO -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: FILTROS -->
            <RowDefinition Height="*"/>
            <!-- Fila 2: TABLA (Expande) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 3: FOOTER -->
        </Grid.RowDefinitions>

        <!-- =========================================
             1. TÍTULO (Fila 0)
             ========================================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="HISTORIAL Y REPORTES" 
                       Style="{StaticResource TituloCyber}"/>
            <TextBlock Text="FILTRA POR FECHAS Y EXPORTA LA INFORMACIÓN" 
                       Style="{StaticResource SubtituloCyber}"/>
        </StackPanel>

        <!-- =========================================
             2. BARRA DE FILTROS (Fila 1) - CORREGIDO
             ========================================= -->
        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,20">
            <!-- CAMBIO: Usamos WrapPanel para que los elementos bajen si no entran -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Fecha Desde -->
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="DESDE:" Foreground="#AAA" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDesde" Width="140" Style="{StaticResource DatePickerCyber}"/>
                </StackPanel>

                <!-- Fecha Hasta -->
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="HASTA:" Foreground="#AAA" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpHasta" Width="140" Style="{StaticResource DatePickerCyber}"/>
                </StackPanel>

                <!-- Estado -->
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="ESTADO:" Foreground="#AAA" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbEstado" Style="{StaticResource ComboCyber}" Width="140" Height="38">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Asignada"/>
                        <ComboBoxItem Content="En Proceso"/>
                        <ComboBoxItem Content="Finalizada"/>
                        <ComboBoxItem Content="Cancelada"/>
                    </ComboBox>
                </StackPanel>

                <!-- Botón Buscar -->
                <!-- Ajusté el Margin Top a 16 para alinearlo con los inputs visualmente -->
                <Button Content="🔍 FILTRAR" Click="btnFiltrar_Click" 
                        Style="{StaticResource BtnNeon}" 
                        Height="38" Width="120" Margin="0,16,20,10"/>

                <!-- Botón Limpiar -->
                <Button Content="Limpiar filtros" Click="btnLimpiar_Click" 
                        Background="Transparent" Foreground="#AAA" 
                        BorderThickness="0" Margin="0,16,0,10" Cursor="Hand"
                        Height="38" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <TextBlock Text="{TemplateBinding Content}" 
                                           TextDecorations="Underline" 
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Border>

        <!-- =========================================
             3. TABLA DE RESULTADOS (Fila 2)
             ========================================= -->
        <DataGrid Grid.Row="2" x:Name="dgReportes" 
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="{x:Null}"
                  BorderThickness="0"
                  RowHeight="50"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">
            <!-- Margen abajo para separar del footer -->

            <DataGrid.Columns>
                <!-- 1. ID -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888888"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 2. FECHA -->
                <DataGridTextColumn Header="FECHA DESEADA" 
                                    Binding="{Binding FechaDeseada, StringFormat=dd/MM/yyyy}" 
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 3. CLIENTE -->
                <DataGridTextColumn Header="CLIENTE / SOLICITANTE" 
                                    Binding="{Binding Cliente.NombreCompleto}" 
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#DDDDDD"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 4. DIRECCIÓN -->
                <DataGridTextColumn Header="DOMICILIO" 
                                    Binding="{Binding Direccion}" 
                                    Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource NeonBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 5. ESTADO (BADGES) -->
                <DataGridTemplateColumn Header="ESTADO" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" 
                                    Padding="10,5" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Estado.Descripcion}" 
                                           FontWeight="Bold" 
                                           FontSize="11"/>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="Pendiente">
                                                <Setter Property="Background" Value="#26FFC107"/>
                                                <Setter Property="TextBlock.Foreground" Value="#FFC107"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="Asignada">
                                                <Setter Property="Background" Value="#262196F3"/>
                                                <Setter Property="TextBlock.Foreground" Value="#2196F3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="En Proceso">
                                                <Setter Property="Background" Value="#2600E5FF"/>
                                                <Setter Property="TextBlock.Foreground" Value="#00E5FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="Finalizada">
                                                <Setter Property="Background" Value="#2600E676"/>
                                                <Setter Property="TextBlock.Foreground" Value="#00E676"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="Realizada">
                                                <Setter Property="Background" Value="#2600E676"/>
                                                <Setter Property="TextBlock.Foreground" Value="#00E676"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado.Descripcion}" Value="Cancelada">
                                                <Setter Property="Background" Value="#26FF5252"/>
                                                <Setter Property="TextBlock.Foreground" Value="#FF5252"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. FOOTER (EXPORTAR) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="txtTotal" Text="0 registros" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,20,0"/>

            <!-- Botón PDF -->
            <Button Content="📄 PDF" Click="btnPdf_Click" 
            Style="{StaticResource BtnNeon}" Background="#FF5252" Width="100" Margin="0,0,10,0"/>

            <!-- Botón Excel -->
            <Button Content="📊 EXCEL" Click="btnExcel_Click" 
            Style="{StaticResource BtnNeon}" Background="#00E676" Width="120"/>
        </StackPanel>

    </Grid>
</Page>