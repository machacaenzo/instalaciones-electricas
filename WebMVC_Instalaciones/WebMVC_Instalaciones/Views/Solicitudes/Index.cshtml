@model IEnumerable<WebMVC_Instalaciones.Models.Solicitud>

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="title-cyber mb-0">MIS SOLICITUDES</h2>
        <p class="subtitle-cyber">HISTORIAL DE SERVICIOS</p>
    </div>
    <a asp-action="Crear" class="btn-neon" style="width: auto; margin-top: 0; padding: 10px 30px;">
        <i class="bi bi-plus-lg me-2"></i> NUEVA SOLICITUD
    </a>
</div>

@if (!Model.Any())
{
    <!-- ESTADO VACÍO -->
    <div class="glass-panel text-center py-5">
        <i class="bi bi-clipboard-x text-secondary" style="font-size: 3rem;"></i>
        <h4 class="text-white mt-3">No tenés solicitudes activas</h4>
        <p class="text-white-50">Creá una nueva para solicitar un técnico.</p>
    </div>
}
else
{
    <!-- GRILLA DE TARJETAS -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-panel h-100 p-4 position-relative hover-effect">

                    <!-- BADGE DE ESTADO ACTUALIZADO -->
                    <div class="position-absolute top-0 end-0 m-3">
                        @if (item.IdEstadoSolicitud == 1) // Pendiente
                        {
                            <span class="badge bg-warning text-dark border border-warning shadow-sm">PENDIENTE</span>
                        }
                        else if (item.IdEstadoSolicitud == 2) // Asignada (El técnico aún no fue)
                        {
                            <span class="badge bg-primary text-white border border-primary">TÉCNICO ASIGNADO</span>
                        }
                        else if (item.IdEstadoSolicitud == 3) // En Proceso (El técnico ya está trabajando)
                        {
                            <span class="badge bg-info text-dark border border-info animate-pulse">TRABAJANDO...</span>
                        }
                        else if (item.IdEstadoSolicitud == 4) // Finalizada
                        {
                            <span class="badge bg-success text-white border border-success">FINALIZADA</span>
                        }
                        else // Cancelada (5)
                        {
                            <span class="badge bg-danger text-white border border-danger">CANCELADA</span>
                        }
                    </div>

                    <!-- FECHA -->
                    <div class="d-flex align-items-center mb-3 text-white-50">
                        <i class="bi bi-calendar-event me-2"></i>
                        <small>@item.FechaDeseada.ToShortDateString()</small>
                    </div>

                    <!-- TÍTULO/DIRECCIÓN -->
                    <h5 class="text-white fw-bold mb-2">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>@item.Direccion
                    </h5>

                    <!-- DESCRIPCIÓN -->
                    <p class="text-white-50 small mb-0 border-top border-secondary border-opacity-25 pt-3 mt-3">
                        @item.Descripcion
                    </p>
                    <!-- ACCIONES (Solo si está pendiente) -->
                    @if (item.IdEstadoSolicitud == 1)
                    {
                        <div class="mt-3 pt-3 border-top border-secondary border-opacity-25 text-end">
                            <!-- BOTÓN EDITAR -->
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-0 me-2" title="Modificar datos">
                                <i class="bi bi-pencil-square"></i> EDITAR
                            </a>
                            <!-- Usamos un formulario pequeño para enviar el POST de borrado -->
                            <!-- Formulario Cancelar -->
                            <form id="form-cancelar-@item.Id" asp-action="Cancelar" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="button" class="btn btn-sm btn-outline-danger border-0"
                                        onclick="ConfirmarAccion('¿CANCELAR SOLICITUD?', 'Esta acción no se puede deshacer.', 'form-cancelar-@item.Id')">
                                    <i class="bi bi-trash3-fill"></i> CANCELAR PEDIDO
                                </button>
                            </form>

                        </div>

                    }
                </div>
            </div>
        }
    </div>
}

<style>
    /* Efecto al pasar el mouse por la tarjeta */
    .hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 255, 0, 0.1);
            border-color: rgba(212, 255, 0, 0.3);
        }
</style>