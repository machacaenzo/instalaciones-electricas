<Window x:Class="WPF_InstalacionesElectricas.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_InstalacionesElectricas"
      mc:Ignorable="d" 
      Title="Acceso al Sistema"  
      Height="750" Width="1200"
      WindowStartupLocation="CenterScreen" 
      WindowStyle="None" 
      AllowsTransparency="True" 
      Background="Transparent" 
      MouseLeftButtonDown="Grid_MouseLeftButtonDown">

    <Grid>
        <!-- 1. FONDO CON IMAGEN -->
        <Border CornerRadius="20" ClipToBounds="True">
            <Grid>
                <Image Source="/Imagenes/FondoLogin.jpeg" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="10"/>
                    </Image.Effect>
                </Image>
                <!-- Capa oscura para contraste -->
                <Rectangle Fill="{DynamicResource ColorFondo}" Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- Botón Cerrar (X) -->
        <Button Content="✕" Click="btnCerrar_Click" 
                Style="{StaticResource WindowCloseBtn}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"/>

        <!-- 2. TARJETA DE LOGIN (Glassmorphism) -->
        <Border Style="{StaticResource GlassPanel}" 
                Width="420" Height="520" 
                HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel VerticalAlignment="Center" Margin="10">
                <!-- Títulos -->
                <TextBlock Text="SYSTEM ACCESS" Style="{StaticResource TituloCyber}" HorizontalAlignment="Center"/>
                <TextBlock Text="AUTENTICACIÓN REQUERIDA" Style="{StaticResource SubtituloCyber}" HorizontalAlignment="Center" Margin="0,5,0,40"/>

                <!-- Campo Correo -->
                <TextBlock Text="USUARIO / CORREO" Foreground="White" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                <TextBox x:Name="txtCorreo" 
                         Style="{StaticResource InputCyber}"
                         Text="admin@empresa.com"
                         GotKeyboardFocus="txtCorreo_GotKeyboardFocus" 
                         LostKeyboardFocus="txtCorreo_LostKeyboardFocus"
                         Margin="0,0,0,20"/>

                <!-- Campo Contraseña -->
                <TextBlock Text="CONTRASEÑA" Foreground="White" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                <PasswordBox x:Name="txtClave" 
                             Style="{StaticResource PasswordCyber}"
                             Password="password"
                             GotKeyboardFocus="txtClave_GotKeyboardFocus" 
                             LostKeyboardFocus="txtClave_LostKeyboardFocus"
                             Margin="0,0,0,40"/>

                <!-- Botón Login -->
                <Button x:Name="btnLogin" Content="INICIAR SISTEMA" 
                        Style="{StaticResource BtnNeon}" 
                        Click="btnLogin_Click"/>

                <!-- Enlace de ayuda (Decorativo) -->
                <TextBlock Text="¿Problemas de acceso? Contacte a soporte." 
                           Foreground="{DynamicResource TextoGris}" FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand" TextDecorations="Underline" Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>